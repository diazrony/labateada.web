{
  "name": "la-bateada",
  "version": "1.0.0",
  "description": "Pagina minimalista con los resultados de MLB del dia",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/style.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./public/style.css --watch",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.120.0"
  }
}
